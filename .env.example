# Copy this file to ".env" and fill in your own Supabase project values.
# Dashboard -> Project Settings -> API. The anon key is a public client key;
# your data is protected by the Row Level Security in supabase/schema.sql.
# Only EXPO_PUBLIC_ vars are exposed to the app, and they are inlined at build.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
