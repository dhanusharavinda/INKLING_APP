{
  "expo": {
    "name": "Inkling",
    "slug": "inkling-ai-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF7F0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dhanusharavind.inkling"
    },
    "android": {
      "package": "com.dhanusharavind.inkling",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Inkling uses your microphone so you can speak your journal entries."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Inkling shows a photo of your choice as a ghost image so you can trace it on your shared doodle page."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "UsDoodle",
              "label": "Inkling · Our Doodle",
              "description": "The page you two doodle on together",
              "minWidth": "130dp",
              "minHeight": "130dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "UsTogether",
              "label": "Inkling · Together",
              "description": "Tap to drift closer to your person",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ]
  }
}
